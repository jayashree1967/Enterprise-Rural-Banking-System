# Copy to .env and fill with local values. Never commit .env.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DB_NAME=rural_banking_db
DB_USER=bankuser
DB_PASSWORD=replace-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production only: set these after HTTPS is configured on your reverse proxy.
# DEBUG=False
# ALLOWED_HOSTS=your-real-domain.example
# CORS_ALLOWED_ORIGINS=https://your-real-frontend.example
